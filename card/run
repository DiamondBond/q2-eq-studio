#!/bin/sh
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 the q2-filebrowser authors (internal/LICENSE)
# From q2-filebrowser's contrib/shanlingq2/launcher.sh (github.com/group-a-study/q2-filebrowser).
#
# Installed as /mnt/mmc/.eq-studio/run. Q2 Pod runs it from Library → Apps' EQ Studio row (a card
# app, q2-pod's patch/addon.c). It runs from /tmp, never the card: the app and this launcher are
# copied there first and the card's copy of this script is left at once (exec), so nothing keeps
# the card busy and USB storage can always take it. The loop restarts the app after a failure,
# waiting 5 s and doubling to a minute; an exit of 0 (idle, or a TERM) ends it. Q2 Pod stops it
# with a TERM to the loop's pid in /tmp/q2-eq-studio.
pid=/tmp/q2-eq-studio
if [ "$1" != --loop ]; then
    [ -f $pid ] && kill -0 "$(cat $pid)" 2>/dev/null && exit 0
    dir=$(cd "$(dirname "$0")" && pwd)
    cp -f "$dir/q2-eq-studio" /tmp/q2-eq-studio.bin && chmod 755 /tmp/q2-eq-studio.bin || exit 1
    cp -f "$0" /tmp/q2-eq-studio.run || exit 1
    cd /tmp
    exec /bin/sh /tmp/q2-eq-studio.run --loop "$dir"
fi
dir=$2
(
    echo 1000 > /proc/self/oom_score_adj # under memory pressure the app goes before Q2 Pod's demo
    child=
    trap '[ -n "$child" ] && kill -TERM $child 2>/dev/null && wait $child; rm -f $pid /tmp/q2-eq-studio.bin /tmp/q2-eq-studio.run; exit 0' TERM INT
    delay=5
    while :; do
        /tmp/q2-eq-studio.bin -dir "$dir" &
        child=$!
        wait $child
        code=$?
        [ $code = 0 ] && break
        sleep $delay &
        wait $! # a TERM ends the wait at once
        [ $delay -lt 60 ] && delay=$((delay * 2))
    done
    rm -f $pid /tmp/q2-eq-studio.bin /tmp/q2-eq-studio.run
) </dev/null >/dev/null 2>&1 &
echo $! > $pid
